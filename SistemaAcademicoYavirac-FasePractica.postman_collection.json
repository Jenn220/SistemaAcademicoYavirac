    {
      "name": "04. Workflow Estado Documentos",
      "description": "Ciclo: borrador a pendiente_revision a rechazado a pendiente_revision a aprobado",
      "item": [
        {
          "name": "Student envia F01 a revision",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"pendiente_revision\",\n  \"comentarios\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Student envia a revision', () => pm.expect(pm.response.json().estado).to.eql('pendiente_revision'));"
          ]}}]
        },
        {
          "name": "Docente rechaza con comentario",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{docToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"rechazado\",\n  \"comentarios\": \"Revise el nombre del estudiante\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('Docente rechazo con comentario', () => {",
            "  pm.expect(r.estado).to.eql('rechazado');",
            "  pm.expect(r.comentarios).to.eql('Revise el nombre del estudiante');",
            "});"
          ]}}]
        },
        {
          "name": "Student REENVIO a revision (comentarios limpios) - FIX",
          "description": "FIX: el boton Enviar a revision ahora aparece en estado 'rechazado', y al reenviar se limpian los comentarios",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"pendiente_revision\",\n  \"comentarios\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('Reenvio OK, comentarios limpios', () => {",
            "  pm.expect(r.estado).to.eql('pendiente_revision');",
            "  pm.expect(r.comentarios).to.eql('');",
            "});"
          ]}}]
        },
        {
          "name": "Docente aprueba",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{docToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"aprobado\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Aprobado', () => pm.expect(pm.response.json().estado).to.eql('aprobado'));"]}}]
        },
        {
          "name": "Student bloqueado de aprobar (403)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"aprobado\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Student blocked (403)', () => pm.expect(pm.response.code).to.eql(403));"]}}]
