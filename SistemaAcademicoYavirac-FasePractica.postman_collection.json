    {
      "name": "02. Datos Maestra",
      "item": [
        {
          "name": "Obtener datos maestra (auto-completado)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }],
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/datos?idPractica={{idPractica}}", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "datos"], "query": [{ "key": "idPractica", "value": "{{idPractica}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const d = pm.response.json();",
            "pm.test('Datos maestra - estudiante', () => pm.expect(d.estudiante.nombre).to.exist);",
            "pm.test('Datos maestra - carrera', () => pm.expect(d.carrera.coordinador).to.exist);",
            "pm.test('Datos maestra - empresa', () => pm.expect(d.proyectoEmpresarial.empresaAsignada).to.exist);",
            "pm.test('Datos maestra - periodo', () => pm.expect(d.periodoAcademico.nombre).to.exist);"
          ]}}]
        }
      ]
    },
