    {
      "name": "06. Bitacora Semanal",
      "item": [
        {
          "name": "Obtener bitacoras",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }],
            "url": { "raw": "{{base_url}}/api/fase-practica/bitacora-semanal/informe/8", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "bitacola-semanal", "informe", "8"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bitacoras OK', () => pm.expect(pm.response.code).to.eql(200));"]}}]
        },
        {
          "name": "Crear bitacora (fecha DD/MM/YYYY)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_informe\": 8,\n  \"semana\": 99,\n  \"fecha_inicio_semana\": \"01/09/2025\",\n  \"fecha_fin_semana\": \"07/09/2025\",\n  \"puesto_aprendizaje\": \"Puesto\",\n  \"actividades_realizadas\": \"Test\",\n  \"actividades_autonomas\": \"Test\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/bitacora-semanal", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "bitacola-semanal"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bitacora creada', () => pm.expect(pm.response.code).to.eql(201));",
            "pm.collectionVariables.set('idBitacora', pm.response.json().id_bitacora);"
          ]}}]
        },
        {
          "name": "PATCH bitacola (fecha DD/MM/YYYY - antes fallaba con 400)",
          "description": "BUG FIX: antes lanzaba 400/500 porque PostgreSQL 'date' no aceptaba DD/MM/YYYY",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha_inicio_semana\": \"15/08/2025\",\n  \"fecha_fin_semana\": \"21/08/2025\",\n  \"actividades_realizadas\": \"Actualizado\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/bitacora-semanal/{{idBitacora}}", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "bitacola-semanal", "{{idBitacora}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Bitacola PATCH DD/MM/YYYY OK (200)', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.test('Fecha guardada', () => pm.expect(pm.response.json().fecha_inicio_semana).to.eql('15/08/2025'));"
          ]}}]
        },
        {
          "name": "PATCH bitacola (fechas vacias)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha_inicio_semana\": \"\",\n  \"fecha_fin_semana\": \"\"\n}" },
            "url": { "raw": "{{base_url}}/api/fase-practica/bitacora-semanal/{{idBitacora}}", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "bitacola-semanal", "{{idBitacora}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bitacola PATCH fechas vacias OK', () => pm.expect(pm.response.code).to.eql(200));"]}}]
        },
        {
          "name": "Eliminar bitacola",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }],
            "url": { "raw": "{{base_url}}/api/fase-practica/bitacora-semanal/{{idBitacora}}", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "bitacola-semanal", "{{idBitacora}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bitacola eliminada', () => pm.expect(pm.response.code).to.eql(200));"]}}]
        }
      ]
