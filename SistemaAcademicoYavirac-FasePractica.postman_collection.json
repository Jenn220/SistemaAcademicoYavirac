    {
      "name": "04. Workflow Estado Documentos",
      "description": "Ciclo: borrador → pendiente_revision → rechazado → pendiente_revision → aprobado",
      "item": [
        {
          "name": "Student envía F01 a revisión",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": JSON.stringify({ estado: "pendiente_revision", comentarios: "" }) },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Student envia a revision', () => pm.expect(pm.response.json().estado).to.eql('pendiente_revision'));"
          ]}}]
        },
        {
          "name": "Docente rechaza con comentario",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{docToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": JSON.stringify({ estado: "rechazado", comentarios: "Revise el nombre del estudiante" }) },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('Docente rechazo con comentario', () => {",
            "  pm.expect(r.estado).to.eql('rechazado');",
            "  pm.expect(r.comentarios).to.eql('Revise el nombre del estudiante');",
            "});"
          ]}}]
        },
        {
          "name": "Student REENVÍO a revisión (comentarios limpios)",
          "description": "FIX: el botón Enviar a revisión ahora aparece en estado 'rechazado', y al reenviar se limpian los comentarios",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{estToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": JSON.stringify({ estado: "pendiente_revision", comentarios: "" }) },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "pm.test('Reenvio OK, comentarios limpios', () => {",
            "  pm.expect(r.estado).to.eql('pendiente_revision');",
            "  pm.expect(r.comentarios).to.eql('');",
            "});"
          ]}}]
        },
        {
          "name": "Docente aprueba",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{docToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": JSON.stringify({ estado: "aprobado" }) },
            "url": { "raw": "{{base_url}}/api/fase-practica/documentos/{{idF01}}/estado", "host": ["{{base_url}}"], "path": ["api", "fase-practica", "documentos", "{{idF01}}", "estado"] }
          },
