  "item": [
    {
      "name": "01. LOGIN",
      "item": [
        {
          "name": "Login - Estudiante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"estudiante@yavirac.edu.ec\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login estudiante OK', () => pm.expect(pm.response.code).to.eql(200));",
                "pm.test('accessToken presente', () => pm.expect(pm.response.json().accessToken).to.exist);",
                "pm.test('Role ESTUDIANTE', () => pm.expect(pm.response.json().usuario.roles).to.include('ESTUDIANTE'));",
                "pm.collectionVariables.set('estToken', pm.response.json().accessToken);",
                "pm.collectionVariables.set('idPractica', pm.response.json().usuario.idPractica || 6);"
              ]
            }
          }]
        },
        {
          "name": "Login - Docente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"carlos@yavirac.edu.ec\",\n  \"password\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Login docente OK', () => pm.expect(pm.response.code).to.eql(200));",
            "pm.collectionVariables.set('docToken', pm.response.json().accessToken);"
          ]}}]
        },
        {
          "name": "Login - Tutor Empresarial",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"ana@empresaxyz.com\",\n  \"password\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
